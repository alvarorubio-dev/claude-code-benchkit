+func TestDeprecations(t *testing.T) {
+	root := &Command{Use: "root"}
+	old := &Command{Use: "old", Deprecated: "use new", Run: emptyRun}
+	cur := &Command{Use: "new", Run: emptyRun}
+	nested := &Command{Use: "nested", Deprecated: "gone", Run: emptyRun}
+	cur.AddCommand(nested)
+	root.AddCommand(old, cur)
+
+	got := root.Deprecations()
+	if len(got) != 1 || got[0] != old {
+		t.Fatalf("expected only %q, got %v", old.Name(), got)
+	}
+	if d := cur.Deprecations(); len(d) != 1 || d[0] != nested {
+		t.Fatalf("expected nested deprecated command, got %v", d)
+	}
+	if d := old.Deprecations(); len(d) != 0 {
+		t.Fatalf("expected none, got %v", d)
+	}
+}
