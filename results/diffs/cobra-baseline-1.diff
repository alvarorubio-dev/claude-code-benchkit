+// Deprecations returns the direct subcommands that are marked as deprecated.
+func (c *Command) Deprecations() []*Command {
+	var deprecated []*Command
+	for _, sub := range c.commands {
+		if len(sub.Deprecated) != 0 {
+			deprecated = append(deprecated, sub)
+		}
+	}
+	return deprecated
+}
