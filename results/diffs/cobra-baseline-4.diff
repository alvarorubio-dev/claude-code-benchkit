+func TestDeprecations(t *testing.T) {
+	root := &Command{Use: "root"}
+	if got := root.Deprecations(); len(got) != 0 {
+		t.Errorf("expected no deprecations for command without children, got %d", len(got))
+	}
+
+	b := &Command{Use: "b", Deprecated: "use c"}
+	a := &Command{Use: "a", Deprecated: "use d"}
+	ok := &Command{Use: "ok"}
+	nested := &Command{Use: "nested", Deprecated: "gone"}
+	ok.AddCommand(nested)
+	root.AddCommand(b, ok, a)
+
+	got := root.Deprecations()
+	if len(got) != 2 || got[0] != a || got[1] != b {
+		t.Errorf("expected [a b], got %v", got)
+	}
+	if got := ok.Deprecations(); len(got) != 1 || got[0] != nested {
+		t.Errorf("expected [nested], got %v", got)
+	}
+}
