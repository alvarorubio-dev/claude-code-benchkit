+/**
+ * Send an RFC 9457 `application/problem+json` response.
+ *
+ * Examples:
+ *
+ *     res.problem(404, 'User 42 not found');
+ *     res.problem(422, 'Invalid input', { errors: [] });
+ *
+ * @param {number} status
+ * @param {string} [detail]
+ * @param {object} [extensions] additional members (e.g. type, instance)
+ * @public
+ */
+
+res.problem = function problem(status, detail, extensions) {
+  status = Number(status);
+  if (!Number.isInteger(status) || status < 400 || status > 599) {
+    throw new RangeError('res.problem status must be an integer 4xx or 5xx code');
+  }
+
+  var obj = {};
+  if (extensions && typeof extensions === 'object') {
+    Object.assign(obj, extensions);
+  }
+  if (obj.type === undefined) obj.type = 'about:blank';
+  obj.title = statuses.message[status] || 'Unknown Error';
+  obj.status = status;
+  if (detail !== undefined && detail !== null) obj.detail = String(detail);
+
+  this.status(status);
+  this.set('Content-Type', 'application/problem+json');
+  return this.json(obj);
+};
+
