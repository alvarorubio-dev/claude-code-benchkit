+/**
+ * Send an RFC 9457 `application/problem+json` response.
+ *
+ * The body contains `type` ("about:blank"), `title` (the status message),
+ * `status` and, when provided, `detail`.
+ *
+ * Examples:
+ *
+ *     res.problem(404, 'User 42 not found');
+ *
+ * @param {number} status
+ * @param {string} [detail]
+ * @public
+ */
+
+res.problem = function problem(status, detail) {
+  if (typeof status !== 'number' || !Number.isInteger(status) || status < 400 || status > 599) {
+    throw new TypeError('res.problem() requires an error status code (400-599)')
+  }
+
+  var body = {
+    type: 'about:blank',
+    title: statuses.message[status] || String(status),
+    status: status
+  }
+
+  if (detail !== undefined && detail !== null) {
+    body.detail = String(detail)
+  }
+
+  this.status(status)
+  this.set('Content-Type', 'application/problem+json')
+
+  return this.json(body)
+};
