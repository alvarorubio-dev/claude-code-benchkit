+func TestDeprecations(t *testing.T) {
+	root := &Command{Use: "root"}
+	if got := root.Deprecations(); len(got) != 0 {
+		t.Fatalf("expected no deprecations, got %d", len(got))
+	}
+	old := &Command{Use: "old", Deprecated: "use new"}
+	cur := &Command{Use: "cur"}
+	old2 := &Command{Use: "aold", Deprecated: "gone"}
+	root.AddCommand(old, cur, old2)
+	nested := &Command{Use: "nested", Deprecated: "x"}
+	cur.AddCommand(nested)
+
+	got := root.Deprecations()
+	if len(got) != 2 || got[0] != old2 || got[1] != old {
+		t.Fatalf("unexpected deprecations: %v", got)
+	}
+	if got := cur.Deprecations(); len(got) != 1 || got[0] != nested {
+		t.Fatalf("unexpected nested deprecations: %v", got)
+	}
+}
