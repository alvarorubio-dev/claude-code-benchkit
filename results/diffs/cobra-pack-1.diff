+// Deprecations returns the direct subcommands of c that are marked as
+// deprecated (have a non-empty Deprecated message), in the same order as
+// Commands().
+func (c *Command) Deprecations() []*Command {
+	var deprecated []*Command
+	for _, sub := range c.Commands() {
+		if len(sub.Deprecated) > 0 {
+			deprecated = append(deprecated, sub)
+		}
+	}
+	return deprecated
+}
