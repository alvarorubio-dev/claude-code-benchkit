+func TestDeprecations(t *testing.T) {
+	root := &Command{Use: "root"}
+	if got := root.Deprecations(); len(got) != 0 {
+		t.Errorf("expected no deprecations, got %d", len(got))
+	}
+
+	old := &Command{Use: "old", Deprecated: "use new"}
+	cur := &Command{Use: "cur"}
+	older := &Command{Use: "a-older", Deprecated: "gone soon"}
+	nested := &Command{Use: "nested"}
+	nested.AddCommand(&Command{Use: "deep", Deprecated: "x"})
+	root.AddCommand(old, cur, older, nested)
+
+	got := root.Deprecations()
+	if len(got) != 2 || got[0] != older || got[1] != old {
+		t.Fatalf("unexpected deprecations: %v", got)
+	}
+	// Only direct subcommands are listed.
+	if len(cur.Deprecations()) != 0 {
+		t.Errorf("expected none for non-deprecated leaf")
+	}
+	if len(nested.Deprecations()) != 1 {
+		t.Errorf("expected nested to report its deprecated child")
+	}
+}
